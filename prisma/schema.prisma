datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  name    String?
  password  String
  createdAt DateTime @default(now())
}

model Dress {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  title String
  price String
  coverIndex Int @default(0)
  sizes String[]
  tags String[] @default([])
  images String[]  @default([])
  createdAt DateTime @default(now())
  activityEvents ActivityEvent[]
}

model ActivityEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dressId   String   @db.ObjectId
  type      String   // "VIEW", "CONTACT", "SHARE", "FAVORITE"
  createdAt DateTime @default(now())
  
  dress     Dress    @relation(fields: [dressId], references: [id], onDelete: Cascade)
}
